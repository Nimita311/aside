{
  "name": "aside-webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev-server.mjs",
    "mock": "node mock/server.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mock/tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:mock": "npm run typecheck && vitest run mock/test",
    "prebuild": "node ../cli/check-node.cjs",
    "predev": "node ../cli/check-node.cjs",
    "premock": "node ../cli/check-node.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dompurify": "^3.4.17",
    "marked": "^15.0.0",
    "mermaid": "^12.2.0",
    "yaml": "^2.8.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
